<!-- Synthetic web.config fixtures for rule tests, never deployed. -->
<configuration>
  <connectionStrings>
    <!-- ruleid: web-config-connection-string-password -->
    <add name="Hrmis" connectionString="Server=hrdb;Database=HRMIS;User Id=sa;Password=P@ssw0rd123;" providerName="System.Data.SqlClient" /><!-- gitleaks:allow -->
    <!-- ok: web-config-connection-string-password -->
    <add name="Intranet" connectionString="Server=intra;Database=Intranet;Integrated Security=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <!-- ruleid: web-config-debug-on -->
    <compilation debug="true" targetFramework="4.8" />
    <!-- ok: web-config-debug-on -->
    <compilation debug="false" targetFramework="4.8" />
    <!-- ruleid: web-config-custom-errors-off -->
    <customErrors mode="Off" />
    <!-- ok: web-config-custom-errors-off -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error" />
    <!-- ruleid: web-config-request-validation-off -->
    <pages validateRequest="false" />
    <!-- ok: web-config-request-validation-off -->
    <pages validateRequest="true" />
