FROM matt-vapt-kit:0.3.0
USER root
WORKDIR /opt/matt-vapt-kit
RUN pip install --no-cache-dir ".[report]" \
    && PLAYWRIGHT_BROWSERS_PATH=/opt/browsers playwright install --with-deps --only-shell chromium \
    && chmod -R a+rX /opt/browsers
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/browsers
USER 10001:10001
WORKDIR /workspace
