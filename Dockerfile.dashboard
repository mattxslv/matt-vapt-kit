FROM gcr.io/google.com/cloudsdktool/google-cloud-cli@sha256:73a97b855d386c74bee3facd59ccc261006c55a9812b7913fa6b93816010a1bc AS gcloud
FROM python:3.12-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e
COPY --from=gcloud /usr/lib/google-cloud-sdk /opt/google-cloud-sdk
ENV PATH="/opt/google-cloud-sdk/bin:${PATH}" \
    PLAYWRIGHT_BROWSERS_PATH=/opt/browsers \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    CLOUDSDK_CORE_DISABLE_USAGE_REPORTING=true \
    HOME=/tmp
WORKDIR /opt/matt-vapt-kit
COPY pyproject.toml README.md ./
COPY vaptkit ./vaptkit
RUN pip install --no-cache-dir ".[dashboard,report]" \
    && playwright install --with-deps --only-shell chromium \
    && groupadd --gid 10001 vapt \
    && useradd --uid 10001 --gid 10001 --create-home vapt \
    && mkdir /data \
    && chown 10001:10001 /data \
    && chmod -R a+rX /opt/browsers
USER 10001:10001
ENV MVK_LISTEN_HOST=0.0.0.0 MVK_PROJECTS_DIR=/projects MVK_DATA_DIR=/data
EXPOSE 8765
ENTRYPOINT ["vapt-dashboard"]
