#!/bin/sh
set -eu
kit_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ ! -x "$kit_dir/.venv/bin/python" ]; then
    if ! command -v python3 >/dev/null 2>&1; then
        printf '%s\n' "Python 3.11+ is required. Install Python first."
        exit 2
    fi
    printf '%s\n' "First run: creating the toolkit's local Python environment."
    python3 -m venv "$kit_dir/.venv"
fi
first_install=0
if ! "$kit_dir/.venv/bin/python" -c 'import rich, vaptkit.menu' >/dev/null 2>&1; then
    printf '%s\n' "Installing the toolkit, terminal and PDF report dependencies (downloads Python packages)."
    "$kit_dir/.venv/bin/python" -m pip install --quiet -e "$kit_dir[report]"
    first_install=1
elif ! "$kit_dir/.venv/bin/python" -c 'import playwright' >/dev/null 2>&1; then
    printf '%s\n' "Adding the PDF report tools (downloads Python packages)."
    "$kit_dir/.venv/bin/python" -m pip install --quiet -e "$kit_dir[report]"
else
    # An editable install keeps running the latest code automatically, but its recorded
    # version/dependency metadata freezes at whatever it was on the last `pip install -e .` -
    # without this, a version bump that adds a new dependency would silently never get installed.
    pyproject_version=$(grep -m1 '^version = ' "$kit_dir/pyproject.toml" | sed -E 's/version = "(.*)"/\1/')
    installed_version=$("$kit_dir/.venv/bin/python" -c '
from importlib.metadata import PackageNotFoundError, version
try:
    print(version("matt-vapt-kit"))
except PackageNotFoundError:
    print("")
' 2>/dev/null || printf '')
    if [ "$pyproject_version" != "$installed_version" ]; then
        printf '%s\n' "Updating the toolkit to v$pyproject_version..."
        "$kit_dir/.venv/bin/python" -m pip install --quiet -e "$kit_dir[report]"
    fi
fi
if ! "$kit_dir/.venv/bin/python" -c 'from playwright.sync_api import sync_playwright as s; p = s().start(); b = p.chromium.launch(); b.close(); p.stop()' >/dev/null 2>&1; then
    printf '%s\n' "Downloading the browser used to print PDF reports (about 150 MB, one time)."
    "$kit_dir/.venv/bin/python" -m playwright install chromium || printf '%s\n' "PDF browser download failed; reports will be saved as HTML until you re-run ./install."
fi
# Not gated to first_install: someone who installed before Docker support existed, or who
# said no to Docker but later got nothing else working (no native Nuclei/ZAP either), would
# otherwise never see this again. The decline marker (inside .venv, never committed) stops it
# from nagging on every single run once someone has actually said no.
docker_declined_marker="$kit_dir/.venv/.docker-prompt-declined"
if ! command -v docker >/dev/null 2>&1 && [ ! -e "$docker_declined_marker" ]; then
    printf '\n%s\n' "Docker was not found. It's needed for secret/dependency/static checks and local attack testing"
    printf '%s\n' "(Nuclei/ZAP can also run natively without it - see 'vaptkit --help' for that path)."
    if command -v brew >/dev/null 2>&1; then
        printf '%s' "Install Docker Desktop now via brew? (y/N) "
        read -r reply || reply=n
        if [ "$reply" = "y" ] || [ "$reply" = "Y" ]; then
            printf '%s\n' "Installing Docker Desktop (this may prompt for your password)..."
            brew install --cask docker
            printf '%s\n' "Launch Docker Desktop once from Applications before using checks that need it."
        else
            printf '%s\n' "Skipped. Install Docker from https://www.docker.com/products/docker-desktop/ if needed."
            printf '%s\n' "This won't ask again; delete .venv/.docker-prompt-declined to be asked on the next run."
            touch "$docker_declined_marker"
        fi
    elif command -v apt-get >/dev/null 2>&1; then
        printf '%s' "Install Docker Engine now via apt (needs sudo)? (y/N) "
        read -r reply || reply=n
        if [ "$reply" = "y" ] || [ "$reply" = "Y" ]; then
            printf '%s\n' "Installing Docker Engine (this may prompt for your password)..."
            curl -fsSL https://get.docker.com | sudo sh
            sudo usermod -aG docker "$USER" 2>/dev/null || true
            printf '%s\n' "Installed. Log out and back in (or run 'newgrp docker') for group access to take effect."
        else
            printf '%s\n' "Skipped. Install Docker from https://docs.docker.com/engine/install/ if needed."
            printf '%s\n' "This won't ask again; delete .venv/.docker-prompt-declined to be asked on the next run."
            touch "$docker_declined_marker"
        fi
    else
        printf '%s\n' "No known package manager (brew/apt) found to install it automatically. Get Docker from"
        printf '%s\n' "https://docs.docker.com/engine/install/ if you need checks that require it."
    fi
fi
if [ "$first_install" = 1 ]; then
    printf '%s\n' "Installed. Protecting every Git project found under your home folder on every git push..."
    exec "$kit_dir/.venv/bin/vaptkit" --protect-all "$@"
fi
exec "$kit_dir/.venv/bin/vaptkit" "$@"
