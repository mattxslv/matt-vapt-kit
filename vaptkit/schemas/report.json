{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "target",
    "started_at",
    "finished_at",
    "status",
    "profile",
    "scope_sha256",
    "approved_paths",
    "observations",
    "findings",
    "errors",
    "coverage"
  ],
  "properties": {
    "cloud_review": {"type": "object"},
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "string",
      "maxLength": 64
    },
    "target": {
      "type": "string",
      "maxLength": 2048
    },
    "started_at": {
      "type": "string",
      "maxLength": 64
    },
    "finished_at": {
      "type": "string",
      "maxLength": 64
    },
    "status": {
      "enum": [
        "completed",
        "incomplete",
        "fixture"
      ]
    },
    "profile": {
      "type": "string",
      "maxLength": 128
    },
    "scope_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approved_paths": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "observations": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "method",
          "status",
          "checks"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "method": {
            "const": "HEAD"
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "checks": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "html_response",
              "hsts_present",
              "csp_present",
              "nosniff",
              "frame_policy_present"
            ],
            "properties": {
              "html_response": {
                "type": "boolean"
              },
              "hsts_present": {
                "type": "boolean"
              },
              "csp_present": {
                "type": "boolean"
              },
              "nosniff": {
                "type": "boolean"
              },
              "frame_policy_present": {
                "type": "boolean"
              },
              "hsts_strong": {
                "type": "boolean"
              },
              "csp_script_strong": {
                "type": "boolean"
              },
              "frame_policy_strong": {
                "type": "boolean"
              },
              "referrer_policy_safe": {
                "type": "boolean"
              },
              "cookies_secure": {
                "type": "boolean"
              },
              "session_cookies_httponly": {
                "type": "boolean"
              },
              "no_version_disclosure": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "severity",
          "verification",
          "category",
          "path",
          "impact",
          "remediation"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "maxLength": 64
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "informational"
            ]
          },
          "verification": {
            "enum": [
              "confirmed",
              "suspected",
              "observation"
            ]
          },
          "category": {
            "enum": [
              "data_exposure",
              "unauthorized_access",
              "configuration"
            ]
          },
          "path": {
            "$ref": "#/$defs/path"
          },
          "impact": {
            "type": "string",
            "maxLength": 2000
          },
          "remediation": {
            "type": "string",
            "maxLength": 2000
          },
          "owasp": {
            "enum": [
              "A01",
              "A02",
              "A03",
              "A04",
              "A05",
              "A06",
              "A07",
              "A08",
              "A09",
              "A10"
            ]
          },
          "cvss": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "score",
              "vector"
            ],
            "properties": {
              "version": {
                "enum": [
                  "3.1",
                  "4.0"
                ]
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "vector": {
                "type": "string",
                "pattern": "^CVSS:(3\\.1|4\\.0)/[A-Za-z0-9:/.]{1,200}$"
              }
            }
          },
          "evidence": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind",
          "message"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "kind": {
            "enum": [
              "scope",
              "transport",
              "http"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 256
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_exposure",
        "unauthorized_access",
        "note"
      ],
      "properties": {
        "data_exposure": {
          "enum": [
            "not_tested",
            "tested"
          ]
        },
        "unauthorized_access": {
          "enum": [
            "not_tested",
            "tested"
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "verification_observations": {
      "type": "array",
      "maxItems": 10,
      "items": {"$ref": "#/properties/observations/items"}
    },
    "requests": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "path", "status"],
        "properties": {
          "method": {"enum": ["HEAD", "GET", "POST"]},
          "path": {"$ref": "#/$defs/path"},
          "status": {"type": "integer", "minimum": 100, "maximum": 599}
        }
      }
    },
    "role_accounts": {
      "type": "array", "minItems": 2, "maxItems": 9, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}
    },
    "role_cleanup": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["account", "status"],
        "properties": {
          "account": {"type": "string", "maxLength": 64},
          "status": {"enum": ["acknowledged", "unconfirmed"]}
        }
      }
    },
    "role_observations": {
      "type": "array", "maxItems": 90,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["account", "role", "path", "expected_allowed", "attempts"],
        "properties": {
          "account": {"type": "string", "maxLength": 64},
          "role": {"type": "string", "maxLength": 64},
          "path": {"$ref": "#/$defs/path"},
          "expected_allowed": {"type": "boolean"},
          "attempts": {
            "type": "array", "maxItems": 2,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["status", "content_class", "shape_matched"],
              "properties": {
                "status": {"type": "integer", "minimum": 100, "maximum": 599},
                "content_class": {"enum": ["html", "json", "text", "javascript", "binary", "none"]},
                "shape_matched": {"type": "boolean"},
                "evidence_quality": {"enum": ["matched", "empty", "cached", "unmatched", "denied", "blocked"]}
              }
            }
          }
        }
      }
    },
    "exposure": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind",
          "status",
          "exposed",
          "signature"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "kind": {
            "enum": [
              "baseline",
              "secret_file",
              "vcs",
              "debug",
              "health",
              "api_docs",
              "source_map"
            ]
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "exposed": {
            "type": "boolean"
          },
          "signature": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "retest": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "path",
          "status"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "path": {
            "$ref": "#/$defs/path"
          },
          "status": {
            "enum": [
              "still_present",
              "resolved",
              "not_rechecked"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "maxLength": 256
    }
  }
}
