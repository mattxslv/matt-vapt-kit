{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Matt VAPT Kit project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "target",
    "scope",
    "credentials"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "access": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "service_account"],
          "properties": {
            "type": {"const": "iap-service-account"},
            "service_account": {
              "type": "string",
              "not": {"pattern": "\\s"},
              "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "token_env",
            "header"
          ],
          "properties": {
            "type": {
              "const": "bearer"
            },
            "token_env": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "header": {
              "enum": [
                "Authorization",
                "Proxy-Authorization"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "iap-browser"
            },
            "remember_login": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "url",
        "allowed_hosts",
        "verification"
      ],
      "properties": {
        "environment": {
          "const": "staging"
        },
        "url": {
          "type": "string",
          "maxLength": 2048
        },
        "allowed_hosts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
          }
        },
        "verification": {
          "enum": [
            "pending",
            "reachable-not-authorized"
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_prefixes",
        "excluded_prefixes",
        "roles"
      ],
      "properties": {
        "api_prefixes": {
          "$ref": "#/$defs/paths"
        },
        "excluded_prefixes": {
          "$ref": "#/$defs/paths"
        },
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token_env"
        ],
        "properties": {
          "token_env": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      }
    },
    "role_testing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "accounts", "routes"],
      "properties": {
        "adapter": {"const": "dtap-cookie-v1"},
        "accounts": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "role", "email_env", "password_env"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
              "role": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
              "email_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
              "password_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
            }
          }
        },
        "routes": {
          "type": "array", "minItems": 1, "maxItems": 10,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "allowed_roles", "response_shape"],
            "properties": {
              "path": {"type": "string", "maxLength": 256},
              "allowed_roles": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}
              },
              "response_shape": {
                "type": "object", "minProperties": 1, "maxProperties": 10,
                "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"},
                "additionalProperties": {"enum": ["array", "object", "string", "number", "boolean"]}
              }
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "public_routes": {
          "$ref": "#/$defs/paths"
        },
        "privileged_prefixes": {
          "$ref": "#/$defs/paths"
        },
        "exclude_files": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "auth_patterns": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "role_patterns": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    }
  },
  "$defs": {
    "paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/",
        "maxLength": 2048
      }
    }
  }
}
